<div class="[[class]]" data-embed-src="[[src]]" data-embed-title="[[frameTitle]]" data-embed-consent="[[consent]]" data-embed-host="[[host]]"[[remember]]>
	<button type="button" class="embed-open" hidden>
		[[poster]]
		<span class="embed-caption">
			<svg class="embed-play" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 64 64" fill="currentColor" aria-hidden="true" focusable="false"><circle cx="32" cy="32" r="31" fill="none" stroke="currentColor" stroke-width="2"/><path d="M26 20.5v23l19-11.5z"/></svg>
			<span class="embed-label">[[label]]</span>
			<span class="embed-note">[[/feature/embed/placeholder/note]] [[host]]</span>
		</span>
	</button>
	<noscript><p class="embed-fallback"><a href="[[src]]" target="_blank" rel="noopener noreferrer">[[/feature/embed/fallback/link]] [[host]]</a></p></noscript>
</div>
