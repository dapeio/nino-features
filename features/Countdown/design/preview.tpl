<div class="nino-grid-row">
	<div class="nino-grid-100 nino-mb-3">
		<p id="countdown-text" class="nino-text-left">[[short]]</p>
		<div class="nino-countdown" id="countdown-full">
			<time class="nino-countdown-date" id="countdown-full-date" datetime="2026-12-24T18:00:00+01:00" hidden>2026-12-24 18:00</time>
			<div class="nino-countdown-parts" id="countdown-full-parts" aria-live="off">
				<span class="nino-countdown-part"><span class="nino-countdown-value">12</span><span class="nino-countdown-name">[[/feature/countdown/unit-day/many]]</span></span>
				<span class="nino-countdown-part"><span class="nino-countdown-value">8</span><span class="nino-countdown-name">[[/feature/countdown/unit-hour/many]]</span></span>
				<span class="nino-countdown-part"><span class="nino-countdown-value">45</span><span class="nino-countdown-name">[[/feature/countdown/unit-minute/many]]</span></span>
				<span class="nino-countdown-part"><span class="nino-countdown-value">30</span><span class="nino-countdown-name">[[/feature/countdown/unit-second/many]]</span></span>
			</div>
		</div>
	</div>
	<div class="nino-grid-100 nino-mb-3">
		<div class="nino-countdown" id="countdown-short">
			<time class="nino-countdown-date" id="countdown-short-date" datetime="2026-12-24T18:00:00+01:00" hidden>2026-12-24 18:00</time>
			<div class="nino-countdown-parts" id="countdown-short-parts" aria-live="off">
				<span class="nino-countdown-part"><span class="nino-countdown-value">1</span><span class="nino-countdown-name">[[/feature/countdown/unit-day/one]]</span></span>
				<span class="nino-countdown-part"><span class="nino-countdown-value">8</span><span class="nino-countdown-name">[[/feature/countdown/unit-hour/many]]</span></span>
			</div>
		</div>
	</div>
</div>
