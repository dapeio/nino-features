[section-wrap id="search" ground="base"]
	[section-row width="narrow"]
		[section-col]
			[section-title ~title tag="h1"]
			[search-form]
			[search-count]
			[search-results /_placeholder empty="~empty"]
				[section-title .title tag="h2" size="s"]
				[text .text]
			[/search-results]
		[/section-col]
	[/section-row]
[/section-wrap]
