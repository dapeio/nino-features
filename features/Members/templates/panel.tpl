<!-- The Members panel, rendered whole into the workbench's pane (see
     Admin::template()): the head over the pane names it, this file owns what is
     inside. Three regions, which admin.js draws into - the button that signs
     everybody out, the form for a new member, and the list - so that a list that
     is drawn again after a change leaves what is typed into the form where it
     is. Every word is a fill the script asks for; nothing is written here. -->
<div id="members-app" class="members-panel">
	<div id="members-tools"></div>
	<div id="members-new"></div>
	<div id="members-people"></div>
</div>
