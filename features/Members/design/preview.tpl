<div class="nino-grid-row">
	<div class="nino-grid-100 nino-mb-3">
		<form class="members-login" id="members-form">
			<label for="members-email" class="members-login__label">[[short]]</label>
			<input type="email" id="members-email" class="nino-form-input" placeholder="[[placeholder]]" autocomplete="off">
			<p class="members-login__state" id="members-state">[[short]]</p>
			<button type="button" class="nino-btn nino-btn--primary" id="members-submit">[[short]]</button>
		</form>
	</div>
	<div class="nino-grid-100 nino-mb-3">
		<div class="members-signed" id="members-signed">
			<span class="members-signed__label">[[short]]</span>
			<strong class="members-signed__name" id="members-name">[[short]]</strong>
			<a href="#members-signed" class="members-logout" id="members-logout">[[short]]</a>
		</div>
	</div>
</div>
