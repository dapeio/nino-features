<div style="max-width:600px; margin:0 auto; padding:[[/project/mail/spacing/large]] [[/project/mail/spacing/medium]]; background:[[/project/mail/color/background]]; color:[[/project/mail/color/text]]; font-family:-apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif; line-height:[[/project/mail/font/line-height]];">
	<h1 style="margin:0 0 [[/project/mail/spacing/medium]]; font-size:[[/project/mail/font/large]]; color:[[/project/mail/color/text]];">[[/feature/files/mail/new-title]] [[/project/company/general/name]]</h1>
	<p style="margin:0 0 [[/project/mail/spacing/medium]];">[[/feature/files/mail/new-greeting]] [[name]],</p>
	<p style="margin:0 0 [[/project/mail/spacing/medium]];">[[/feature/files/mail/new-intro]] [[folder]]:</p>
	<ul style="margin:0 0 [[/project/mail/spacing/medium]]; padding-left:20px;">[[files]]</ul>
	<p style="margin:0 0 [[/project/mail/spacing/medium]]; text-align:center;">
		<a href="[[link]]" style="display:inline-block; padding:[[/project/mail/spacing/small]] [[/project/mail/spacing/medium]]; background:[[/project/mail/color/primary]]; color:[[/project/mail/color/background]]; text-decoration:none;">[[/feature/files/mail/new-button]]</a>
	</p>
	<p style="margin:0 0 [[/project/mail/spacing/medium]]; font-size:[[/project/mail/font/small]];">[[/feature/files/mail/new-notice]]</p>
	<p style="margin:0;">[[/feature/files/mail/closing]]<br>[[/project/company/general/name]]</p>
</div>
