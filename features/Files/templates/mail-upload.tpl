<div style="max-width:600px; margin:0 auto; padding:[[/project/mail/spacing/large]] [[/project/mail/spacing/medium]]; background:[[/project/mail/color/background]]; color:[[/project/mail/color/text]]; font-family:-apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif; line-height:[[/project/mail/font/line-height]];">
	<h1 style="margin:0 0 [[/project/mail/spacing/medium]]; font-size:[[/project/mail/font/large]]; color:[[/project/mail/color/text]];">[[/feature/files/mail/upload-title]]</h1>
