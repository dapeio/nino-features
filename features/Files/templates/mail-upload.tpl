	<p style="margin:0 0 [[/project/mail/spacing/medium]];"><strong>[[file]]</strong> ([[size]])</p>
	<p style="margin:0 0 [[/project/mail/spacing/medium]];">[[/feature/files/mail/label-folder]] [[folder]]<br>[[/feature/files/mail/label-by]] [[who]]</p>
