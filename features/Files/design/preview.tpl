<div class="nino-grid-row">
	<div class="nino-grid-100 nino-mb-3">
		<div class="files-browser" id="files-browser">
			<div class="files-folder" id="files-folder">
				<h3 class="files-folder__title"><span class="files-folder__name">[[short]]</span> <span class="files-folder__count">3</span></h3>
				<ul class="files-folder__list">
					<li class="files-row" id="files-row-first">
						<a class="files-row__name" href="#files-row-first">[[short]]</a>
						<span class="files-row__size">4.2 MB</span>
						<time class="files-row__date" datetime="2026-11-02">2026-11-02</time>
						<a class="files-row__download" href="#files-row-first">[[short]]</a>
					</li>
					<li class="files-row" id="files-row-second">
						<a class="files-row__name" href="#files-row-second">[[short]]</a>
						<span class="files-row__size">812 KB</span>
						<time class="files-row__date" datetime="2026-10-28">2026-10-28</time>
						<a class="files-row__download" href="#files-row-second">[[short]]</a>
					</li>
					<li class="files-row" id="files-row-third">
						<a class="files-row__name" href="#files-row-third">[[short]]</a>
						<span class="files-row__size">120 MB</span>
						<time class="files-row__date" datetime="2026-10-15">2026-10-15</time>
						<a class="files-row__download" href="#files-row-third">[[short]]</a>
					</li>
				</ul>
			</div>
		</div>
	</div>
	<div class="nino-grid-100 nino-mb-3">
		<form class="files-upload" id="files-form">
			<label for="files-input" class="files-upload__label">[[short]]</label>
			<input type="file" id="files-input" class="files-upload__input">
			<p class="files-upload__hint">[[short]]</p>
			<p class="files-upload__state" id="files-state">[[short]]</p>
			<button type="button" class="nino-btn nino-btn--primary" id="files-submit">[[short]]</button>
		</form>
	</div>
</div>
