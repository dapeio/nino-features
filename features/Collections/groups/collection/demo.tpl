[section-wrap ground="base"]
	[section-row]
		[section-col]
			[section-title tag="h2" size="m" text="A list"]
			[collection-list /_placeholder variant="check" sort="title"][text .title][/collection-list]
		[/section-col]
	[/section-row]
	[section-row]
		[section-col]
			[section-title tag="h2" size="m" text="A table"]
			[collection-table /_placeholder sort="-date" caption="The example elements"][collection-col .title title="Title" rowhead][collection-col .date title="Date" as="date"][collection-col .price title="Price" as="currency" align="end"][collection-col .text title="Notes"][/collection-table]
		[/section-col]
	[/section-row]
[/section-wrap]
