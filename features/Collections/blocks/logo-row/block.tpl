[section-wrap id="logos" ground="base"]
	[section-row width="wide" gap="3" valign="center"]
		[section-col align="center"]
			[section-title ~title tag="h2" size="s"]
		[/section-col]
	[/section-row]
	[section-row width="wide" gap="3" valign="center"]
		[collection /_placeholder]
			[section-col size="50 m:25" align="center" pad="3"]
				[image /nino/placeholder/mark alt=".title" href=".link"]
			[/section-col]
		[/collection]
	[/section-row]
[/section-wrap]