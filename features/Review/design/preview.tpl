<div class="nino-grid-row">
	<div class="nino-grid-100 nino-mb-3">
		<div class="review-player" id="review-player">
			<p class="review-player__back"><a href="#review-player">[[short]]</a></p>
			<h3 class="review-player__title">[[short]]</h3>
			<audio class="review-player__media" id="review-media" controls preload="none"></audio>
			<h4 class="review-player__comments">[[short]] <span class="review-player__count">2</span></h4>
			<ol class="review-comments" id="review-comments">
				<li class="review-comment" id="review-comment-first">
					<div class="review-comment__head">
						<a class="review-comment__time" href="#review-comment-first">1:05</a>
						<strong class="review-comment__who">[[short]]</strong>
						<time class="review-comment__date" datetime="2026-11-02">2026-11-02</time>
					</div>
					<p class="review-comment__text">[[lorem]]</p>
				</li>
				<li class="review-comment review-comment--done" id="review-comment-second">
					<div class="review-comment__head">
						<a class="review-comment__time" href="#review-comment-second">2:30</a>
						<strong class="review-comment__who">[[short]]</strong>
						<time class="review-comment__date" datetime="2026-10-28">2026-10-28</time>
						<span class="review-comment__done">[[short]]</span>
					</div>
					<p class="review-comment__text">[[lorem]]</p>
				</li>
			</ol>
			<form class="review-form" id="review-form">
				<p class="review-form__field">
					<label for="review-at" class="review-form__label">[[short]]</label>
					<input type="text" id="review-at" class="review-form__at" value="1:05">
				</p>
				<p class="review-form__field">
					<label for="review-text" class="review-form__label">[[short]]</label>
					<textarea id="review-text" class="review-form__text" rows="3"></textarea>
				</p>
				<p class="review-state" id="review-state">[[short]]</p>
				<button type="button" class="nino-btn nino-btn--primary" id="review-submit">[[short]]</button>
			</form>
		</div>
	</div>
</div>
