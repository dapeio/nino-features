<li class="review-answer[[modifier]]" data-review-id="[[id]]"[[at]]>
	<div class="review-comment__head">
		[[time]]
		<strong class="review-comment__who">[[who]]</strong>
		<time class="review-comment__date" datetime="[[created]]">[[date]]</time>
		[[mark]]
	</div>
	<p class="review-comment__text">[[text]]</p>
	<button type="button" class="review-comment__reply" data-review-reply hidden>[[/feature/review/comment/reply]]</button>
	[[answers]]
</li>
