<form class="nino-form nino-newsletter-form[[inline]][[classes]]" method="post" action="[[/nino/dir]]/.newsletter" novalidate>
	[csrf]
	<input type="text" name="location" value="" tabindex="-1" autocomplete="off" aria-hidden="true" class="nino-form-trap">
	<label for="[[id]]" class="[[hidden]]">[[/feature/newsletter/signup/label]]</label>
	<input type="email" id="[[id]]" name="email" class="nino-form-input" placeholder="[[/feature/newsletter/signup/placeholder]]" autocomplete="email" required>
	<button type="submit" class="nino-btn nino-btn--primary nino-form-submit">[[/feature/newsletter/label/submit]]</button>
	<p class="nino-form-message nino-grid-100" aria-live="polite"></p>
</form>
