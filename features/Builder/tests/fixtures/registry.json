            "preview": "image",
            "attributes": {
                "alt": {
                    "type": "string",
                    "label": "Alternative text",
                    "hint": "Used where the slot has no text of its own. Empty marks the picture as decoration.",
                    "default": ""
                },
                "focus": {
                    "type": "select",
                    "label": "Focus",
                    "hint": "Which part of the picture survives a crop, as one of nine positions.",
