        "spacer": {
            "label": "Spacer",
            "source": "none",
            "loop": true,
            "preview": "block",
            "attributes": {
                "size": {
                    "type": "select",
                    "label": "Size",
                    "hint": "",
                    "options": [
                        "1",
                        "2",
                        "3",
