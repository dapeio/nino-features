<section id="services" class="nino-section">
	<div class="nino-grid-row nino-grid-gap-2">
		<div class="nino-grid-100 nino-text-center">
			[title /template/block-services-cards/services/title tag="h2"]
			[subtitle /template/block-services-cards/services/subtitle tag="p"]
		</div>
		<div class="nino-grid-100 nino-grid-s-100 nino-grid-m-33 nino-grid-l-33">
			[card fill="1" padding="3" ground="counter"]
				[card-title /template/block-services-cards/services/first-title tag="h3"]
				[card-text /template/block-services-cards/services/first-text]
			[/card]
		</div>
		<div class="nino-grid-100 nino-grid-s-100 nino-grid-m-33 nino-grid-l-33">
			[card fill="1" padding="3" ground="counter"]
				[card-title /template/block-services-cards/services/second-title tag="h3"]
				[card-text /template/block-services-cards/services/second-text]
			[/card]
		</div>
		<div class="nino-grid-100 nino-grid-s-100 nino-grid-m-33 nino-grid-l-33">
			[card fill="1" padding="3" ground="counter"]
				[card-title /template/block-services-cards/services/third-title tag="h3"]
				[card-text /template/block-services-cards/services/third-text]
			[/card]
		</div>
	</div>
</section>
