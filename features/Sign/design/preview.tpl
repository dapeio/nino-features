<div class="nino-grid-row">
	<div class="nino-grid-100 nino-mb-3">
		<div class="sign-form" id="sign-form">
			<h2 class="sign-form__title" id="sign-title">[[short]]</h2>
			<p class="sign-form__consent" id="sign-consent">
				<input type="checkbox" id="sign-box">
				<label for="sign-box">[[short]]</label>
			</p>
			<div class="sign-pad" id="sign-pad">
				<p class="sign-pad__label" id="sign-pad-label">[[short]]</p>
				<canvas class="sign-pad__canvas" id="sign-canvas" width="600" height="200" aria-labelledby="sign-pad-label"></canvas>
			</div>
			<p class="sign-form__state" id="sign-state">[[short]]</p>
			<div class="sign-form__actions" id="sign-actions">
				<button type="button" class="nino-btn nino-btn--primary" id="sign-sign">[[short]]</button>
				<button type="button" class="nino-btn nino-btn--outline" id="sign-decline">[[short]]</button>
			</div>
		</div>
	</div>
	<div class="nino-grid-100 nino-mb-3">
		<div class="sign-list" id="sign-list">
			<ul class="sign-list__rows">
				<li class="sign-list__row" id="sign-row-first" data-sign-state="requested">
					<span class="sign-list__title">[[short]]</span>
					<span class="sign-list__state">[[short]]</span>
					<time class="sign-list__date" datetime="2026-11-02">2026-11-02</time>
					<a class="sign-list__page" href="#sign-row-first">[[short]]</a>
				</li>
				<li class="sign-list__row" id="sign-row-second" data-sign-state="signed">
					<span class="sign-list__title">[[short]]</span>
					<span class="sign-list__state">[[short]]</span>
					<time class="sign-list__date" datetime="2026-10-28">2026-10-28</time>
					<a class="sign-list__page" href="#sign-row-second">[[short]]</a>
					<a class="sign-list__signed" href="#sign-row-second">[[short]]</a>
				</li>
			</ul>
		</div>
	</div>
</div>
