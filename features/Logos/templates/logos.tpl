<div class="nino-logos-strip nino-logos-strip--h-[[height]][[classes]]" style="--nino-logos-count:[[count]]" data-logos-pause="[[/feature/logos/action/pause]]">
	<div class="nino-logos-strip-view">
		<ul class="nino-logos-strip-list" role="list">[[items]]</ul>
		<ul class="nino-logos-strip-copy" aria-hidden="true">[[copy]]</ul>
	</div>
	<button type="button" class="nino-btn nino-btn--outline nino-btn--small nino-logos-strip-pause" aria-pressed="false" hidden></button>
</div>
