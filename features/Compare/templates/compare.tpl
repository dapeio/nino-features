<figure class="nino-compare nino-compare--[[ratio]]" style="--nino-compare-position:[[start]]%">
	<div class="nino-compare-frame">
		<img class="nino-compare-image nino-compare-image--before" src="[[before]]" alt="[[alt]]" loading="lazy" decoding="async">
		<span class="nino-compare-side nino-compare-side--before">[[beforelabel]]</span>
		<div class="nino-compare-clip">
			<img class="nino-compare-image nino-compare-image--after" src="[[after]]" alt="" loading="lazy" decoding="async" aria-hidden="true">
			<span class="nino-compare-side nino-compare-side--after">[[afterlabel]]</span>
		</div>
		<span class="nino-compare-divider" aria-hidden="true"></span>
	</div>
	<input class="nino-compare-range" type="range" min="0" max="100" step="1" value="[[start]]" aria-label="[[/compare/handle]]" hidden>
	<figcaption class="nino-compare-caption">[[alt]]</figcaption>
</figure>
