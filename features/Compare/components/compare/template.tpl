<figure class="[[class]]" style="--compare-position:[[start]]%">
	<div class="compare-frame">
		<img class="compare-image compare-image--before" src="[[beforeSrc]]" alt="[[alt]]" loading="lazy" decoding="async">
		<span class="compare-side compare-side--before">[[beforeName]]</span>
		<div class="compare-clip">
			<img class="compare-image compare-image--after" src="[[afterSrc]]" alt="" loading="lazy" decoding="async" aria-hidden="true">
			<span class="compare-side compare-side--after">[[afterName]]</span>
		</div>
		<span class="compare-divider" aria-hidden="true"></span>
	</div>
	<input class="compare-range" type="range" min="0" max="100" step="1" value="[[start]]" aria-label="[[/feature/compare/handle/label]]" hidden>
	<figcaption class="compare-caption">[[alt]]</figcaption>
</figure>
