[section-wrap id="toc-article" ground="base"]
	[section-row gap="3" valign="start"]
		[section-col size="100 m:33"]
			[toc within="#toc-article-text" sticky]
		[/section-col]
		[section-col id="toc-article-text" size="100 m:66"]
			[section-title ~title tag="h2"]
			[text ~intro]
			[section-title ~subtitle tag="h3" size="s"]
			[text ~detail]
			[section-title ~closing tag="h2"]
			[text ~outro]
		[/section-col]
	[/section-row]
[/section-wrap]