		<footer class="nino-frame-footer nino-frame-footer--sitemap">
			<div class="nino-grid-row">
				<div class="nino-grid-100 nino-grid-l-33 nino-frame-footer-brand-col">
					<a href="[[/nino/dir]]/" class="nino-frame-footer-brand">
						[image /logo alt=""]<img src="[[src]]" width="[[width]]" height="[[height]]" class="nino-footer-logo" alt="[[alt]]">[/image]
					</a>
					<p class="nino-frame-footer-description">[[/project/company/general/description]]</p>
					<address class="nino-frame-footer-contact">
						<p>[[/project/company/contact/address]]<br>[[/project/company/contact/country]]</p>
						<p>[[/project/company/contact/phone]]<br>[[/project/company/contact/email]]</p>
					</address>
				</div>
				<nav class="nino-grid-100 nino-grid-l-66 nino-frame-footer-nav" aria-label="[[/template/common/navigation/footer]]">
					[template /templates/html-footer-nav]
				</nav>
			</div>
			<div class="nino-grid-row">
				<div class="nino-grid-100 nino-frame-footer-legal">
					<p>&copy; [[/nino/date/year]] [[/project/company/general/name]]</p>
					<div class="nino-frame-footer-utility">
						[navigation nav="legal" id="legal__nav"][/navigation]
						[template /templates/html-footer-localepicker]
					</div>
				</div>
			</div>
		</footer>
