		<footer class="nino-frame-footer">
			<section class="nino-frame-footer-content">
				<div class="nino-grid-row">
					<div class="nino-grid-100 nino-grid-l-50">
						<img src="[[/nino/public]]/images/logo.png" class="nino-footer-logo" alt="[[/project/company/general/name]]">
					</div>
					<address class="nino-grid-100 nino-grid-m-50 nino-grid-l-25 nino-frame-footer-contact">
						<h2>[[/template/frame-footer/contact/title]]</h2>
						<p>[[/project/company/contact/address]]<br>[[/project/company/contact/country]]</p>
						<p>[[/project/company/contact/phone]]<br>[[/project/company/contact/email]]</p>
					</address>
					<nav class="nino-grid-100 nino-grid-m-50 nino-grid-l-25 nino-frame-footer-nav" aria-label="[[/template/common/navigation/footer]]">
						[template /templates/html-footer-nav]
					</nav>
				</div>
			</section>
			<section class="nino-frame-footer-legal">
				<div class="nino-grid-row">
					<div class="nino-grid-100 nino-grid-l-33">
						<p>&copy; [[/nino/date/year]] [[/project/company/general/name]]</p>
					</div>
					<div class="nino-grid-100 nino-grid-l-33">
						[navigation nav="legal" id="legal__nav"][/navigation]
					</div>
					<div class="nino-grid-100 nino-grid-l-33">
						[template /templates/html-footer-localepicker]
					</div>
				</div>
			</section>
		</footer>
