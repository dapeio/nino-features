		<footer class="nino-frame-footer nino-frame-footer--slab">
			<div class="nino-grid-row">
				<div class="nino-grid-100 nino-grid-l-50 nino-frame-footer-message">
					<p class="nino-frame-footer-kicker">[[/project/company/general/name]]</p>
					<p class="nino-frame-footer-description">[[/project/company/general/description]]</p>
					<div class="nino-frame-footer-social">[template /templates/social-links]</div>
				</div>
				<nav class="nino-grid-100 nino-grid-l-25 nino-frame-footer-nav" aria-label="[[/template/common/navigation/footer]]">
					[template /templates/html-footer-nav]
				</nav>
				<address class="nino-grid-100 nino-grid-l-25 nino-frame-footer-contact">
					<p>[[/project/company/contact/address]]<br>[[/project/company/contact/country]]</p>
					<p>[[/project/company/contact/phone]]<br>[[/project/company/contact/email]]</p>
				</address>
			</div>
			<div class="nino-grid-row">
				<div class="nino-grid-100 nino-frame-footer-legal">
					<p>&copy; [[/nino/date/year]] [[/project/company/general/name]]</p>
					<div class="nino-frame-footer-utility">
						[template /templates/html-footer-legal]
						[template /templates/html-footer-localepicker]
					</div>
				</div>
			</div>
		</footer>
