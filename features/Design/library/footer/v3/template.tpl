		<footer class="nino-frame-footer">
			<section class="nino-footer-main">
				<div class="nino-grid-row">
					<div class="nino-grid-100 nino-grid-l-50 nino-frame-footer-brand">
						<img src="[[/nino/public]]/images/logo-invert.png" class="nino-footer-logo" alt="[[/project/company/general/name]]">
						<p>[[/project/company/general/description]]</p>
					</div>
					<address class="nino-grid-100 nino-grid-m-50 nino-grid-l-25 nino-frame-footer-contact">
						<h2 class="nino-footer-title">[[/template/frame-footer/contact/title]]</h2>
						<p><strong>[[/template/frame-footer/label/address]]</strong><br>[[/project/company/contact/address]]<br>[[/project/company/contact/country]]</p>
						<p><strong>[[/template/common/label/phone]]</strong><br>[[/project/company/contact/phone]]</p>
						<p><strong>[[/template/common/label/email]]</strong><br>[[/project/company/contact/email]]</p>
					</address>
					<nav class="nino-grid-100 nino-grid-m-50 nino-grid-l-25 nino-frame-footer-nav" aria-label="[[/template/common/navigation/footer]]">
						[template /templates/html-footer-nav]
					</nav>
				</div>
			</section>
			<section class="nino-footer-legal">
				<div class="nino-grid-row">
					<p class="nino-grid-100 nino-grid-m-50 nino-footer-copyright">&copy; [[/nino/date/year]] [[/project/company/general/name]]</p>
					<div class="nino-grid-100 nino-grid-m-50 nino-frame-footer-utility">
						[navigation nav="legal" id="legal__nav"][/navigation]
						[template /templates/html-footer-localepicker]
					</div>
				</div>
			</section>
		</footer>
