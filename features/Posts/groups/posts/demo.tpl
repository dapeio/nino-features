[section-wrap ground="base"]
	[section-row width="narrow"]
		[section-col]
			[section-title tag="h2" size="m" text="Latest posts"]
		[/section-col]
	[/section-row]
	[section-row]
		[posts /_placeholder limit="3"]
			[section-col size="100 m:33" variant="card" link]
				[text .date size="s"]
				[section-title .title href=".link" tag="h3" size="s"]
				[text .text size="s"]
			[/section-col]
		[/posts]
	[/section-row]
	[section-row]
		[section-col]
			[posts-pager]
		[/section-col]
	[/section-row]
[/section-wrap]
