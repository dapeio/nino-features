<!-- nino:template-name Posts -->
[template /templates/html-header]
[section-wrap id="intro" ground="base"]
	[section-row width="narrow"]
		[section-col]
			[section-title ~title tag="h1"]
			[text ~text]
		[/section-col]
	[/section-row]
	[section-row]
		[posts]
			[section-col size="100 m:50 l:33" variant="card" link]
				[image .image ratio="16-9"]
				[text .date size="s"]
				[section-title .title href=".url" tag="h3" size="s"]
				[text .summary size="s"]
			[/section-col]
		[/posts]
	[/section-row]
	[section-row]
		[section-col]
			[posts-pager]
		[/section-col]
	[/section-row]
[/section-wrap]
[template /templates/html-footer]
