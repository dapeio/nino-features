<!-- nino:template-name Post -->
[template /templates/html-header]
[section-wrap id="post" ground="base"]
	[section-row width="narrow"]
		[posts-entry]
			[section-col]
				[section-title .title tag="h1" size="l"]
				[text .date size="s"]
				[text .author size="s"]
				[image .image ratio="16-9"]
				[text .body]
			[/section-col]
		[/posts-entry]
	[/section-row]
	[section-row width="narrow"]
		[section-col]
			[posts-nav]
		[/section-col]
	[/section-row]
[/section-wrap]
[template /templates/html-footer]
