[section-wrap ground="base"]
	[section-row width="narrow"]
		[section-col]
			[section-title tag="h2" size="m" text="Next dates"]
		[/section-col]
	[/section-row]
	[section-row gap="2"]
		[section-col size="100 m:33" variant="card"]
			[event-when text="2020-06-21T18:00" show="datetime"]
			[section-title tag="h3" size="s" text="A date that is over"]
		[/section-col]
		[section-col size="100 m:33" variant="card"]
			[event-when text="2031-06-21T18:00" show="datetime"]
			[section-title tag="h3" size="s" text="A date to come"]
			[event-ics text="summer-party"]
		[/section-col]
		[section-col size="100 m:33" variant="card"]
			[event-when text="2031-07-01" show="date"]
			[section-title tag="h3" size="s" text="A day"]
		[/section-col]
	[/section-row]
	[section-row]
		[events /_placeholder scope="upcoming" limit="3"]
			[section-col size="100 m:33" variant="card"]
				[event-when .date show="date"]
				[section-title .title tag="h3" size="s"]
			[/section-col]
		[/events]
	[/section-row]
	[section-row]
		[section-col]
			[event-feed]
		[/section-col]
	[/section-row]
[/section-wrap]
