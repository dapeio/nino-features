[section-wrap id="events" ground="base"]
	[section-row width="narrow"]
		[section-col]
			[section-title ~title tag="h2"]
		[/section-col]
	[/section-row]
	[section-row]
		[events /_placeholder limit="3"]
			[section-col size="100 m:33" variant="card"]
				[event-when .date end="end"]
				[section-title .title tag="h3" size="s"]
				[text .text size="s"]
			[/section-col]
		[/events]
	[/section-row]
	[section-row]
		[section-col]
			[event-feed]
		[/section-col]
	[/section-row]
[/section-wrap]
