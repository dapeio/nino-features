<div class="[[class]]"[[hidden]] role="[[role]]" aria-labelledby="consent-title" aria-describedby="consent-text" tabindex="-1" data-consent-cookie="[[cookie]]" data-consent-days="[[days]]">
	<div class="consent-content">
		<p class="consent-title" id="consent-title">[[/feature/consent/banner/title]]</p>
		<p class="consent-text" id="consent-text">[[/feature/consent/banner/text]][[policy]]</p>
		<div class="consent-categories">[[categories]]</div>
	</div>
	<div class="consent-actions">
		<button type="button" class="consent-button" data-consent-action="accept-all">[[/feature/consent/action/accept-all]]</button>
		<button type="button" class="consent-button" data-consent-action="necessary-only">[[/feature/consent/action/necessary-only]]</button>
		<button type="button" class="consent-button" data-consent-action="save">[[/feature/consent/action/save]]</button>
	</div>
</div>
