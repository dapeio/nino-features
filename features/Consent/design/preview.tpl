<div class="nino-grid-row">
	<div class="nino-grid-100 nino-mb-3">
		<div class="nino-consent-stage" id="consent-stage">
			<div class="nino-consent nino-consent--static" id="consent-banner" role="group" aria-labelledby="consent-title" aria-describedby="consent-text">
				<div class="nino-consent-content">
					<p class="nino-consent-title" id="consent-title">[[/feature/consent/banner/title]]</p>
					<p class="nino-consent-text" id="consent-text">[[/feature/consent/banner/text]] <a href="#consent-banner" class="nino-consent-link">[[/feature/consent/banner/link]]</a></p>
					<div class="nino-consent-categories">
						<label class="nino-consent-category"><input type="checkbox" id="consent-necessary" checked disabled><span class="nino-consent-category-name">[[/feature/consent/category-necessary/name]]</span><span class="nino-consent-category-hint">[[/feature/consent/category-necessary/hint]]</span></label>
						<label class="nino-consent-category"><input type="checkbox" id="consent-statistics"><span class="nino-consent-category-name">[[/feature/consent/category-statistics/name]]</span><span class="nino-consent-category-hint">[[/feature/consent/category-statistics/hint]]</span></label>
						<label class="nino-consent-category"><input type="checkbox" id="consent-marketing"><span class="nino-consent-category-name">[[/feature/consent/category-marketing/name]]</span><span class="nino-consent-category-hint">[[/feature/consent/category-marketing/hint]]</span></label>
					</div>
				</div>
				<div class="nino-consent-actions">
					<button type="button" class="nino-btn nino-btn--outline nino-consent-btn" id="consent-accept">[[/feature/consent/action/accept-all]]</button>
					<button type="button" class="nino-btn nino-btn--outline nino-consent-btn" id="consent-necessary-only">[[/feature/consent/action/necessary-only]]</button>
					<button type="button" class="nino-btn nino-btn--outline nino-consent-btn" id="consent-save">[[/feature/consent/action/save]]</button>
				</div>
			</div>
		</div>
	</div>
</div>
