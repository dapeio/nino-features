# A Nino checkout beside the features, for running their tests locally - see
# bin/check.sh. Never versioned here
/nino/

.DS_Store
Thumbs.db

# Patches are handed around, never versioned - the change itself is
*.patch

# What bin/build.php writes - the archives and the catalogue are published,
# never versioned - and a signing key, which never enters a repository
/dist/
*.pem

# A local copy of the directory the catalogue is served from - catalogue.json,
# its signature, the archives and publish.php. What it holds is published, and
# what the server runs is server/publish.php: never versioned here
/public/

# The endpoint's configuration on a server - a token and a key, never here
/server/publish.config.php
