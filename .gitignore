# A Nino checkout beside the features, for running their tests locally - see
# bin/check.sh. Never versioned here
/nino/

.DS_Store
Thumbs.db

# Patches are handed around, never versioned - the change itself is
*.patch

# A signing key never enters a repository
*.pem

# A local mirror of the directory the catalogue is served from - what
# bin/release.sh syncs and bin/build.php writes into: catalogue.json, its
# signature and the archives. What it holds is published, never versioned
/public/
