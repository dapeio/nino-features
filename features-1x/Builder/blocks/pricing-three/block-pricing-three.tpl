<section id="pricing" class="nino-section">
	<div class="nino-grid-row nino-grid-gap-2">
		<div class="nino-grid-100 nino-text-center">
			[title /template/block-pricing-three/pricing/title tag="h2"]
			[subtitle /template/block-pricing-three/pricing/subtitle tag="p"]
		</div>
		<div class="nino-grid-100 nino-grid-s-100 nino-grid-m-33 nino-grid-l-33">
			[card fill="1" padding="3" align="center" ground="counter"]
				[card-title /template/block-pricing-three/pricing/first-name tag="h3"]
				[card-subtitle /template/block-pricing-three/pricing/first-price style="loud"]
				[card-text /template/block-pricing-three/pricing/first-features format="lines"]
				[button /template/block-pricing-three/pricing/first-button href="/" style="outline"]
			[/card]
		</div>
		<div class="nino-grid-100 nino-grid-s-100 nino-grid-m-33 nino-grid-l-33">
			[card fill="1" padding="3" align="center" ground="primary"]
				[card-title /template/block-pricing-three/pricing/second-name tag="h3"]
				[card-subtitle /template/block-pricing-three/pricing/second-price style="loud"]
				[card-text /template/block-pricing-three/pricing/second-features format="lines"]
				[button /template/block-pricing-three/pricing/second-button href="/" style="light"]
			[/card]
		</div>
		<div class="nino-grid-100 nino-grid-s-100 nino-grid-m-33 nino-grid-l-33">
			[card fill="1" padding="3" align="center" ground="counter"]
				[card-title /template/block-pricing-three/pricing/third-name tag="h3"]
				[card-subtitle /template/block-pricing-three/pricing/third-price style="loud"]
				[card-text /template/block-pricing-three/pricing/third-features format="lines"]
				[button /template/block-pricing-three/pricing/third-button href="/" style="outline"]
			[/card]
		</div>
	</div>
</section>
