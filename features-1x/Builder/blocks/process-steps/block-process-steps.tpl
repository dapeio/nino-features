			[text /template/block-process-steps/process/second-text]
		</div>
		<div class="nino-grid-100 nino-grid-s-100 nino-grid-m-50 nino-grid-l-25">
			[title /template/block-process-steps/process/third-number tag="div" style="loud" color="accent"]
			[title /template/block-process-steps/process/third-title]
			[text /template/block-process-steps/process/third-text]
		</div>
		<div class="nino-grid-100 nino-grid-s-100 nino-grid-m-50 nino-grid-l-25">
			[title /template/block-process-steps/process/fourth-number tag="div" style="loud" color="accent"]
