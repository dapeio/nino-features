<section id="process" class="nino-section nino-section--alt">
	<div class="nino-grid-row nino-grid-gap-2">
		<div class="nino-grid-100 nino-text-center">
			[title /template/block-process-steps/process/title tag="h2"]
		</div>
		<div class="nino-grid-100 nino-grid-s-100 nino-grid-m-50 nino-grid-l-25">
			[title /template/block-process-steps/process/first-number tag="div" style="loud" color="accent"]
			[title /template/block-process-steps/process/first-title]
			[text /template/block-process-steps/process/first-text]
		</div>
		<div class="nino-grid-100 nino-grid-s-100 nino-grid-m-50 nino-grid-l-25">
